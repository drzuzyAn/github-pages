<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Чат с ассертивным тренажером</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }
        #chat-box {
            width: 100%;
            height: 300px;
            border: 1px solid #ccc;
            padding: 10px;
            overflow-y: auto;
        }
        #user-input {
            width: 80%;
            padding: 10px;
            margin-top: 10px;
        }
        #send-btn {
            padding: 10px 20px;
            margin-left: 10px;
        }
    </style>
</head>
<body>
    <h1>Практика ассертивности</h1>
    <div id="chat-box"></div>
    <input type="text" id="user-input" placeholder="Введите ваше сообщение...">
    <button id="send-btn">Отправить</button>

    <script>
        const chatBox = document.getElementById('chat-box');
        const userInput = document.getElementById('user-input');
        const sendBtn = document.getElementById('send-btn');

        // Функция для добавления сообщений в чат
        function addMessage(sender, message) {
            const messageElement = document.createElement('div');
            messageElement.innerHTML = `<strong>${sender}:</strong> ${message}`;
            chatBox.appendChild(messageElement);
            chatBox.scrollTop = chatBox.scrollHeight; // Прокрутка вниз
        }

        // Обработка отправки сообщения
        sendBtn.addEventListener('click', async () => {
            const userMessage = userInput.value.trim();
            if (!userMessage) return;

            // Добавляем сообщение пользователя
            addMessage("Вы", userMessage);

            // Очищаем поле ввода
            userInput.value = "";

            // Отправляем запрос к API (замените на ваш API)
            const response = await fetch('https://api.openai.com/v1/chat/completions', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer YOUR_API_KEY'
                },
                body: JSON.stringify({
                    model: "gpt-4",
                    messages: [{ role: "user", content: userMessage }]
                })
            });

            const data = await response.json();
            const botMessage = data.choices[0].message.content;

            // Добавляем ответ бота
            addMessage("Тренажер", botMessage);
        });
    </script>
</body>
</html>
